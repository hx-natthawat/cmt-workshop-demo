# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# จาก LINE Developers Console > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=ใส่_channel_access_token_ที่นี่
LINE_CHANNEL_SECRET=ใส่_channel_secret_ที่นี่

# จาก console.anthropic.com (หรือใช้ key กลางที่วิทยากรแจก)
ANTHROPIC_API_KEY=ใส่_api_key_ที่นี่

PORT=3000
